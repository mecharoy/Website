# Database (Prisma Postgres — copy the values from your Vercel Storage tab)
websitestorage_DATABASE_URL="postgres://...@db.prisma.io:5432/postgres?sslmode=require"


# Email (Resend API - https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@university.edu"
EMAIL_TO="your-email@example.com"

# Admin Access (simple auth for demo - use NextAuth in production)
ADMIN_PASSWORD="your-secure-password-here"

# Session and Admin Auth Secrets (used to sign session and admin tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-random-session-secret-here"
ADMIN_AUTH_SECRET="your-random-admin-auth-secret-here"

# Cron job secret (used to protect /api/cron/cleanup)
CRON_SECRET="your-random-secret-here"

# Vercel Blob Storage (for document uploads - create a Blob store in your Vercel project settings)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
